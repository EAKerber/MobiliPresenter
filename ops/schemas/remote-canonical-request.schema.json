{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/remote-canonical-request.schema.json",
  "title": "RemoteCanonicalRequest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "domain",
    "action",
    "subject",
    "declaredIntent",
    "actor",
    "expectedAuthorities",
    "scope",
    "planner",
    "requiredCapabilities",
    "payload",
    "semanticAuthority",
    "authorizesMutation",
    "requestHash"
  ],
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "locator": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "integer"}
            ]
          }
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {"const": "RemoteCanonicalRequest 0.1"},
    "requestId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "action": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
      }
    },
    "declaredIntent": {"type": "object"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "workerId", "sessionId"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "workerId": {"type": "string", "minLength": 1},
        "sessionId": {"type": "string", "minLength": 1}
      }
    },
    "expectedAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "revision"],
        "properties": {
          "authority": {"$ref": "#/$defs/authority"},
          "revision": {"type": "string", "minLength": 1}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedAuthorities", "forbiddenAuthorities"],
      "properties": {
        "allowedAuthorities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/authority"}
        },
        "forbiddenAuthorities": {
          "type": "array",
          "items": {"$ref": "#/$defs/authority"}
        }
      }
    },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "contract": {"const": "TransitionPlan 0.1"}
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"}
    },
    "payload": {"type": "object"},
    "semanticAuthority": {"const": false},
    "authorizesMutation": {"const": false},
    "requestHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
