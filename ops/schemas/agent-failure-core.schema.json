{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/agent-failure-core-0.1.json",
  "title": "AgentFailureCore 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surface", "phase", "status", "causes", "recovery", "mutationState", "lossyProjection", "readOnly", "semanticAuthority", "authorizesMutation", "failureCoreHash"],
  "properties": {
    "schemaVersion": {"const": "AgentFailureCore 0.1"},
    "surface": {"enum": ["AGENT_CYCLE", "AGENT_TOOL", "REMOTE_CANONICAL", "AGENT_WRITE_LEASE"]},
    "phase": {"enum": ["PARSE", "BEGIN", "RESOLVE", "ADMIT", "DISPATCH", "APPLY", "READBACK", "CLOSE", "TRANSPORT"]},
    "status": {"enum": ["BLOCKED", "UNKNOWN"]},
    "causes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cause"}
    },
    "recovery": {"$ref": "#/$defs/recovery"},
    "mutationState": {"enum": ["NOT_APPLICABLE", "NOT_APPLIED", "APPLIED", "UNKNOWN"]},
    "lossyProjection": {"type": "boolean"},
    "readOnly": {"const": true},
    "semanticAuthority": {"const": false},
    "authorizesMutation": {"const": false},
    "failureCoreHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "source": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "source", "phase"],
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "source": {"$ref": "#/$defs/source"},
        "phase": {"enum": ["PARSE", "BEGIN", "RESOLVE", "ADMIT", "DISPATCH", "APPLY", "READBACK", "CLOSE", "TRANSPORT"]}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationRetry", "operationReplay"],
      "properties": {
        "observationRetry": {"enum": ["SAFE", "UNSAFE", "UNKNOWN", "NOT_APPLICABLE"]},
        "operationReplay": {"enum": ["SAFE", "UNSAFE", "UNKNOWN", "NOT_APPLICABLE"]}
      }
    }
  }
}
