{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/agent-tool-mutation-dispatch-0.1.json",
  "title": "AgentToolMutationDispatch 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cycleInstanceId", "requestHash", "planHash", "proofSetHash", "begin", "actor", "toolId", "targetPolicy", "command", "commandHash", "source", "semanticAuthority", "authorizesMutation", "dispatchHash"],
  "properties": {
    "schemaVersion": {"const": "AgentToolMutationDispatch 0.1"},
    "cycleInstanceId": {"type": "string", "pattern": "^cycle-instance-[0-9a-f]{24}$"},
    "requestHash": {"$ref": "#/$defs/hash"},
    "planHash": {"$ref": "#/$defs/hash"},
    "proofSetHash": {"$ref": "#/$defs/hash"},
    "begin": {"$ref": "#/$defs/begin"},
    "actor": {"$ref": "#/$defs/actor"},
    "toolId": {"type": "string", "minLength": 1},
    "targetPolicy": {"type": "string", "minLength": 1},
    "command": {"type": "object"},
    "commandHash": {"$ref": "#/$defs/hash"},
    "source": {"$ref": "#/$defs/source"},
    "semanticAuthority": {"const": false},
    "authorizesMutation": {"const": false},
    "dispatchHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "begin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "sourceSha", "contextHash"],
      "properties": {
        "runId": {"type": "integer", "minimum": 1},
        "sourceSha": {"$ref": "#/$defs/gitSha"},
        "contextHash": {"$ref": "#/$defs/hash"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "workerId", "sessionId"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "workerId": {"type": "string", "minLength": 1},
        "sessionId": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "requestCommentId", "hostedRunId", "semanticHostSha"],
      "properties": {
        "issueNumber": {"type": "integer", "minimum": 1},
        "requestCommentId": {"type": "integer", "minimum": 1},
        "hostedRunId": {"type": "integer", "minimum": 1},
        "semanticHostSha": {"$ref": "#/$defs/gitSha"}
      }
    }
  }
}
