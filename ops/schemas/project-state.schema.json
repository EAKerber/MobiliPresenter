{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/project-state-2.0.json",
  "title": "MobiliPresenter ProjectState 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "git",
    "published",
    "development"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ProjectState 2.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository"
      ],
      "properties": {
        "id": {
          "const": "mobilipresenter"
        },
        "repository": {
          "const": "EAKerber/MobiliPresenter"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlBranch",
        "activeDevelopmentBranch",
        "protectedBranches"
      ],
      "properties": {
        "controlBranch": {
          "type": "string",
          "minLength": 1
        },
        "activeDevelopmentBranch": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "protectedBranches": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "published": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "artifactManifest"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "artifactManifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initiative",
        "phase",
        "checkpoint",
        "nextTransition",
        "blockers",
        "prNumber"
      ],
      "properties": {
        "initiative": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "nextTransition": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prNumber": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
