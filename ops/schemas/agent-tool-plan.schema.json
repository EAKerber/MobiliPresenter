{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/agent-tool-plan-0.1.json",
  "title": "AgentToolPlan 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestHash", "begin", "actor", "toolId", "effectClass", "mode", "adapter", "requiredCapabilities", "eligibleToolSurfaces", "targetPolicy", "guards", "target", "input", "concrete", "status", "readOnly", "semanticAuthority", "authorizesMutation", "planHash"],
  "properties": {
    "schemaVersion": {"const": "AgentToolPlan 0.1"},
    "requestHash": {"$ref": "#/$defs/hash"},
    "begin": {"$ref": "#/$defs/begin"},
    "actor": {"$ref": "#/$defs/actor"},
    "toolId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "effectClass": {"enum": ["read-only", "shared-durable-mutation", "specialized-maintenance", "transport-side-effect"]},
    "mode": {"enum": ["plan-only", "read-only-execute"]},
    "adapter": {"type": "string", "minLength": 1},
    "requiredCapabilities": {"$ref": "#/$defs/stringList"},
    "eligibleToolSurfaces": {"$ref": "#/$defs/stringList"},
    "targetPolicy": {"type": "string", "minLength": 1},
    "guards": {"$ref": "#/$defs/stringList"},
    "target": {"type": "object"},
    "input": {"type": "object"},
    "concrete": {"type": "object"},
    "status": {"enum": ["PLANNED", "READY"]},
    "readOnly": {"const": true},
    "semanticAuthority": {"const": false},
    "authorizesMutation": {"const": false},
    "planHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "begin": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "sourceSha", "contextHash"],
      "properties": {
        "runId": {"type": "integer", "minimum": 1},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contextHash": {"$ref": "#/$defs/hash"}
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "workerId", "sessionId"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "workerId": {"type": "string", "minLength": 1},
        "sessionId": {"type": "string", "minLength": 1}
      }
    }
  }
}
