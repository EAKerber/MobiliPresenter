{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/source-build-1.1.json",
  "title": "MobiliPresenter SourceBuild 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "sha256", "fingerprintKind", "sourceBranch", "sourceBase", "sourcePaths", "buildCommand", "publishPath", "defaultUiMode", "uiPreviewQuery"],
  "properties": {
    "schemaVersion": {"const": "SourceBuild 1.1"},
    "release": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprintKind": {"const": "sha256(sourceBase|sourcePaths|buildCommand|publishPath)"},
    "sourceBranch": {"type": "string", "minLength": 1},
    "sourceBase": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourcePaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "buildCommand": {"type": "string", "minLength": 1},
    "publishPath": {"type": "string", "minLength": 1},
    "defaultUiMode": {"type": "string", "minLength": 1},
    "uiPreviewQuery": {"type": "string"}
  }
}
