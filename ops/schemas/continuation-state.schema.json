{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/continuation-state-0.1.json",
  "title": "ContinuationState 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "actor", "status", "branch", "prNumber", "completed", "remaining", "nextAction", "lastKnownGood", "blockedBy", "handoffTo"],
  "properties": {
    "schemaVersion": {"const": "ContinuationState 0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "actor": {"type": "string", "minLength": 1},
    "status": {"enum": ["READY", "IN_PROGRESS", "WAITING", "HANDOFF", "DONE"]},
    "branch": {"type": ["string", "null"], "minLength": 1},
    "prNumber": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
    "completed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "remaining": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nextAction": {"type": ["string", "null"], "minLength": 1},
    "lastKnownGood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "checkpoint"],
      "properties": {
        "sha": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
        "checkpoint": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "blockedBy": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "handoffTo": {"type": ["string", "null"], "minLength": 1}
  }
}
