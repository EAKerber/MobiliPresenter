{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/capability-gate-transition-evidence-0.1.json",
  "title": "CapabilityGateTransitionEvidence 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capability",
    "action",
    "planHash",
    "beforeStateHash",
    "afterStateHash",
    "details",
    "evidence",
    "evidencePath"
  ],
  "properties": {
    "schemaVersion": {"const": "CapabilityGateTransitionEvidence 0.1"},
    "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "action": {
      "type": "string",
      "enum": ["init", "gate-add", "next", "pass", "fail", "defer", "review-limit", "promote", "disable"]
    },
    "planHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "beforeStateHash": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "afterStateHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "details": {"type": "object"},
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidencePath": {
      "type": "string",
      "pattern": "^ops/evidence/capability-gates/[a-z0-9][a-z0-9-]*/.+\\.json$"
    }
  }
}
