{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/transition-receipt.schema.json",
  "title": "TransitionReceipt 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planHash",
    "domain",
    "action",
    "subject",
    "authority",
    "beforeStateHash",
    "afterStateHash",
    "readbackStateHash",
    "authorityRevision",
    "verified",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": {"const": "TransitionReceipt 0.1"},
    "planHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "action": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string"},
        "id": {"type": "string"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": {"type": "string"},
        "locator": {"type": "object", "minProperties": 1}
      }
    },
    "beforeStateHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "afterStateHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readbackStateHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorityRevision": {"type": ["string", "null"]},
    "verified": {"const": true},
    "receiptHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
