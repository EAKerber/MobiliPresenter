{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/ecosystem-maxims-0.1.json",
  "title": "EcosystemMaximCatalog 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "readOnly",
    "semanticAuthority",
    "authorizesMutation",
    "overridesContract",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "EcosystemMaximCatalog 0.1"
    },
    "readOnly": {
      "const": true
    },
    "semanticAuthority": {
      "const": false
    },
    "authorizesMutation": {
      "const": false
    },
    "overridesContract": {
      "const": false
    },
    "items": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/maxim"
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "justification",
        "operationalQuestion",
        "misreadRisk",
        "appliesTo",
        "relatedContracts",
        "editorialOwner",
        "deathCondition",
        "semanticAuthority",
        "authorizesMutation",
        "overridesContract"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "operationalQuestion": {
          "type": "string",
          "minLength": 1
        },
        "misreadRisk": {
          "type": "string",
          "minLength": 1
        },
        "appliesTo": {
          "$ref": "#/$defs/stringList"
        },
        "relatedContracts": {
          "$ref": "#/$defs/stringList"
        },
        "editorialOwner": {
          "type": "string",
          "minLength": 1
        },
        "deathCondition": {
          "type": "string",
          "minLength": 1
        },
        "semanticAuthority": {
          "const": false
        },
        "authorizesMutation": {
          "const": false
        },
        "overridesContract": {
          "const": false
        }
      }
    }
  }
}
