{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/project-machine-inspection.schema.json",
  "title": "ProjectMachineInspection 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "scope",
    "sourceHeads",
    "project",
    "sensors",
    "authorities",
    "trust",
    "coherence",
    "observations",
    "readOnly",
    "semanticAuthority",
    "inspectionHash"
  ],
  "properties": {
    "schemaVersion": {"const": "ProjectMachineInspection 0.2"},
    "repository": {"const": "EAKerber/MobiliPresenter"},
    "scope": {"enum": ["local", "base", "live"]},
    "sourceHeads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspection", "control", "coordination", "continuation"],
      "properties": {
        "inspection": {"$ref": "#/$defs/sourceHead"},
        "control": {"$ref": "#/$defs/sourceHead"},
        "coordination": {"$ref": "#/$defs/sourceHead"},
        "continuation": {"$ref": "#/$defs/sourceHead"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateHash",
        "controlBranch",
        "preserveBranches",
        "phase",
        "checkpoint",
        "nextTransition",
        "activeDevelopmentBranch",
        "developmentPrNumber",
        "blockers"
      ],
      "properties": {
        "stateHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "controlBranch": {"type": "string", "minLength": 1},
        "preserveBranches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "phase": {"type": "string", "minLength": 1},
        "checkpoint": {"type": "string", "minLength": 1},
        "nextTransition": {"type": "string", "minLength": 1},
        "activeDevelopmentBranch": {"type": ["string", "null"]},
        "developmentPrNumber": {"type": ["integer", "null"], "minimum": 1},
        "blockers": {"type": "array"}
      }
    },
    "sensors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sensor"}
    },
    "authorities": {
      "type": "array",
      "items": {"$ref": "#/$defs/authority"}
    },
    "trust": {"$ref": "#/$defs/aggregate"},
    "coherence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ok", "complete", "failedChecks", "unknownChecks", "checks"],
      "properties": {
        "status": {"enum": ["PASS", "UNKNOWN", "FAIL"]},
        "ok": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "failedChecks": {"type": "array", "items": {"type": "string"}},
        "unknownChecks": {"type": "array", "items": {"type": "string"}},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/coherenceCheck"}}
      }
    },
    "observations": {"type": "array", "items": {"type": "object"}},
    "readOnly": {"const": true},
    "semanticAuthority": {"const": false},
    "inspectionHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "sourceHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "sha"],
      "properties": {
        "branch": {"type": ["string", "null"]},
        "sha": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]}
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required", "code", "authority", "data"],
      "properties": {
        "status": {"enum": ["PASS", "UNKNOWN", "FAIL"]},
        "required": {"type": "boolean"},
        "code": {"type": ["string", "null"]},
        "authority": {"type": ["object", "null"]},
        "data": {}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "observedBy"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": ["string", "null"]},
        "locator": {"type": "object"},
        "observedBy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ok", "complete", "failedSensors", "unknownSensors"],
      "properties": {
        "status": {"enum": ["PASS", "UNKNOWN", "FAIL"]},
        "ok": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "failedSensors": {"type": "array", "items": {"type": "string"}},
        "unknownSensors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coherenceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "required", "code", "subjects", "detail"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "UNKNOWN", "FAIL"]},
        "required": {"type": "boolean"},
        "code": {"type": "string", "minLength": 1},
        "subjects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "detail": {}
      }
    }
  }
}
