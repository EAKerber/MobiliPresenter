{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilipresenter.local/schemas/agent-tool-guard-proof-set-0.1.json",
  "title": "AgentToolGuardProofSet 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestHash", "planHash", "actor", "target", "proofs", "status", "readOnly", "semanticAuthority", "authorizesMutation", "proofSetHash"],
  "properties": {
    "schemaVersion": {"const": "AgentToolGuardProofSet 0.1"},
    "requestHash": {"$ref": "#/$defs/hash"},
    "planHash": {"$ref": "#/$defs/hash"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "workerId", "sessionId"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "workerId": {"type": "string", "minLength": 1},
        "sessionId": {"type": "string", "minLength": 1}
      }
    },
    "target": {"type": "object"},
    "proofs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "coordination-lease-owned": {"type": "object"},
        "git-cas": {"type": "object"}
      }
    },
    "status": {"const": "PASS"},
    "readOnly": {"const": true},
    "semanticAuthority": {"const": false},
    "authorizesMutation": {"const": false},
    "proofSetHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
